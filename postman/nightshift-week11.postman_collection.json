    {
      "name": "Accounts",
      "item": [
        {
          "name": "1. Register new player (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const user = pm.response.json().user;",
                  "pm.test('Role is PLAYER', function () { pm.expect(user.role).to.eql('PLAYER'); });",
                  "pm.test('No password_hash returned', function () { pm.expect(user).to.not.have.property('password_hash'); });",
                  "pm.collectionVariables.set('promotedUserId', String(user.user_id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"school_id\": \"2099-3001\",\n  \"full_name\": \"Mira Santos\",\n  \"email\": \"mira.santos@nightshift.test\",\n  \"password\": \"NightShift-2026\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
