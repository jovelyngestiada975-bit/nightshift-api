            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Edit\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/shifts/{{shiftId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shifts",
                "{{shiftId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "4. Read shift by ID",
          "event": [
            {
              "listen": "test",
              "script": {
